# Ingestão das previsões da IA (API externa do projeto Grama Webcam).
# Copie para `backend/.env` e preencha. O `.env` é gitignored.
#
# Sem GRAMA_API_KEY a sincronização fica DESLIGADA e o backend serve
# apenas o CSV local versionado em data/ — é o comportamento anterior.

GRAMA_API_URL=https://api-grama-webcam.onrender.com/previsoes
GRAMA_API_KEY=

# Intervalo mínimo entre buscas na API externa, em segundos (default 900 = 15min).
GRAMA_SYNC_TTL_S=900

# Timeout da chamada HTTP, em segundos. O Render free hiberna após ~15min
# e leva ~50s para acordar; se estourar, o backend usa o CSV local.
GRAMA_SYNC_TIMEOUT_S=30
